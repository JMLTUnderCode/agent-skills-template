{
    "name": "agent-skills-installer",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "description": "Instalador de skills de agentes de código desde skills-hub",
    "scripts": {
        "setup": "node install.js",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "test": "node --test --experimental-test-module-mocks \"tests/**/*.test.js\""
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@12.23.0",
    "dependencies": {
        "@clack/prompts": "^0.9.1",
        "degit": "^2.8.4",
        "fs-extra": "^11.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.9"
    }
}
